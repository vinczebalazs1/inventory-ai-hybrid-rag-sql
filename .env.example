# OpenAI

OPENAI_API_KEY=your_openai_api_key_here

# Database configuration

DB_NAME=inventory
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# SQL settings

SQL_QUERY_TIMEOUT_MS=5000
SQL_DEFAULT_LIMIT=50
SQL_MAX_LIMIT=200
SQL_MAX_ROWS_RETURNED=100

# Read-only document extraction
DOCUMENT_CHUNK_SIZE=12000
DOCUMENT_CHUNK_OVERLAP=500
DOCUMENT_MAPPING_BATCH_SIZE=80
DOCUMENT_LLM_MODEL=gpt-6-luna
DOCUMENT_TARGET_TABLE=inventory_items
# Optional predownloaded Docling model directory:
# DOCUMENT_ARTIFACTS_PATH=C:/models/docling

# Read-only record reconciliation (similarity scores, not probabilities)
MATCHING_TARGET_SCHEMA=public
MATCHING_TARGET_TABLE=inventory_items
MATCHING_STRATEGY=hybrid
MATCHING_MAX_CANDIDATES=100
MATCHING_MAX_SCAN_ROWS=1000
MATCHING_QUERY_TIMEOUT_MS=3000
MATCHING_CONNECT_TIMEOUT_SECONDS=5
MATCHING_MAX_FIELD_LENGTH=1000
MATCHING_EXACT_THRESHOLD=0.95
MATCHING_LIKELY_THRESHOLD=0.72
MATCHING_AMBIGUITY_MARGIN=0.05
MATCHING_DUPLICATE_THRESHOLD=0.45
MATCHING_MODEL_CONFLICT_CAP=0.4
MATCHING_INVENTORY_NUMBER_WEIGHT=0.5
MATCHING_ITEM_CODE_WEIGHT=0.4
MATCHING_SUB_CODE_WEIGHT=0.1
MATCHING_NAME_WEIGHT=0.3
MATCHING_LOCATION_WEIGHT=0.1
MATCHING_ACTIVATION_DATE_WEIGHT=0.1
