# Copy to .env.clean.local for admin tools; never commit real credentials.
# The application uses .env and should use the reader account after installation.
DB_NAME=inventory_ai_clean
DB_HOST=localhost
DB_PORT=5432
DB_USER=inventory_ai_reader
DB_PASSWORD=your_password_here
# In the admin tools' local file use the approved database owner/seed account.
# Inherited DB_* values must agree with this file, otherwise tools refuse to run.
